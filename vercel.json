{
  "build": {
    "env": {
      "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
    }
  },
  "env": {
    "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ranchoviejo.com.ar"
        }
      ],
      "destination": "https://ranchoviejo.com.ar/:path*",
      "permanent": true
    }
  ]
}